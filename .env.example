# Скопировать в .env и заполнить.
# Логин в инфраструктуре (выдан команде).
LINQ_LOGIN=hackathonXXXXX
# RabbitMQ (cloud-брокер LinQ), доступен только через VPN.
LINQ_RABBIT_HOST=10.0.114.30
LINQ_RABBIT_PORT=5672
LINQ_RABBIT_USER=guest
LINQ_RABBIT_PASS=guest
LINQ_EXCHANGE=tpu.direct
LINQ_INPUT_QUEUE=input
# Префикс наших очередей ответов (чтобы не пересекаться с другими командами).
LINQ_REPLY_PREFIX=pokus
LINQ_TIMEOUT_S=60
# Где лежат .tpu-программы на их стороне (по умолчанию /auto/cache/<логин>).
LINQ_PROGRAM_DIR=